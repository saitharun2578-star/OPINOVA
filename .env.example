# Opinova Environment Configuration
# Copy this file to .env to customize local credentials

# Application Secret Key for session signing
OPINOVA_SECRET_KEY=opinova-super-secret-key-change-in-production

# Default Administrator Credentials
# Change these values before deploying or launching publicly!
OPINOVA_ADMIN_USER=opinova
OPINOVA_ADMIN_PASSWORD=123456789

# Server port (default 5000)
PORT=5000
FLASK_ENV=production
